# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/liquidopinion

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# ── Admin seed (auto-created on first boot) ────────────
ADMIN_EMAIL=admin@liquidopinion.local
ADMIN_PASSWORD=AdminPassword1!
ADMIN_USERNAME=admin

# ── Passport – Facebook OAuth ──────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# ── Archive defaults ───────────────────────────────────
# Cron schedule for the global archiver (default: every day at 2am)
ARCHIVE_CRON=0 2 * * *
# Days after which votes are archived when creator hasn't set a custom value
ARCHIVE_DEFAULT_DAYS=30
